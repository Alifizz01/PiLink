[Unit]
Description=PiLink Blue Screen UI
After=network-online.target
Requires=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pilink
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m pilink.ui.app --config /etc/pilink.yaml
Restart=on-failure
RestartSec=5
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

